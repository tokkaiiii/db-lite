# 이 파일을 .env로 복사한 뒤 값을 채우고, server.exe(dbtool)와 같은 디렉터리에서
# 실행하세요. .env는 실행 위치의 .env를 자동으로 읽습니다 (DBTOOL_ENV_FILE로
# 다른 경로 지정 가능). 이미 설정된 OS 환경변수가 있으면 그 값이 항상 우선합니다.

# 필수: 로그인 세션(JWT) 서명 키. 충분히 무작위한 문자열로 반드시 바꾸세요.
DBTOOL_JWT_SECRET=

# 선택
# DBTOOL_LISTEN_ADDR=:8080
# DBTOOL_SQLITE_PATH=dbtool.sqlite
# DBTOOL_BOOTSTRAP_ADMIN_USER=admin
# DBTOOL_BOOTSTRAP_ADMIN_PASSWORD=
