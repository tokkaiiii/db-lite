# 참고용으로 클론해둔 외부 저장소 (이 프로젝트에는 포함하지 않음)
/cloudbeaver/
/dbeaver/
/dbeaver-common/

# IDE 설정
.idea/

# 개발 중 생성되는 로그 파일
server/dev-out.log
server/dev-err.log
client/dev.log

# Playwright MCP 실행 아티팩트
.playwright-mcp/

# client build output
/client/dist/

# 셀프호스팅 빌드 시 client/dist를 복사해 넣는 위치 (go:embed 대상).
# .gitkeep만 커밋해서 client 빌드 없이도 `go build`가 되도록 유지한다.
server/internal/httpapi/dist/*
!server/internal/httpapi/dist/.gitkeep
